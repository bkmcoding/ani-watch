{
  "name": "aniwatch-api",
  "version": "2.2.0",
  "description": "ani.watch — HiAnime scrape API with browse + HTML player",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkmcoding/hianime-api.git"
  },
  "bugs": {
    "url": "https://github.com/bkmcoding/hianime-api/issues"
  },
  "homepage": "https://github.com/bkmcoding/hianime-api#readme",
  "scripts": {
    "dev": "bun run --hot index.ts",
    "start": "bun index.ts",
    "build": "bun build index.ts --outdir ./dist --target bun",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf dist node_modules/.cache",
    "vercel-build": "node build-vercel.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.8.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge": "^1.3.3",
    "@vercel/speed-insights": "^2.0.0",
    "aniwatch": "^2.27.9",
    "axios": "^1.13.6",
    "cheerio": "^1.0.0-rc.12",
    "esbuild": "^0.25.12",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vercel/ncc": "^0.38.4",
    "@vitest/ui": "^4.1.1",
    "bun-types": "^1.3.11",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "globals": "^17.4.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vitest": "^4.1.1"
  }
}
