{
  "name": "aniwatch-api",
  "version": "2.2.0",
  "description": "ani.watch — HiAnime scrape API with browse + HTML player",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkmcoding/hianime-api.git"
  },
  "bugs": {
    "url": "https://github.com/bkmcoding/hianime-api/issues"
  },
  "homepage": "https://github.com/bkmcoding/hianime-api#readme",
  "scripts": {
    "dev": "bun run --hot index.ts",
    "start": "bun index.ts",
    "build": "bun build index.ts --outdir ./dist --target bun",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "clean": "rm -rf dist node_modules/.cache",
    "vercel-build": "node build-vercel.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.18",
    "@vercel/analytics": "^2.0.1",
    "@vercel/edge": "^1.3.3",
    "@vercel/speed-insights": "^2.1.0",
    "aniwatch": "^2.27.9",
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^25.9.9",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vercel/ncc": "^0.38.4",
    "@vitest/ui": "^4.1.12",
    "bun-types": "^1.4.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "undici": "^6.29.1",
    "vite": "^8.3.5"
  }
}
